# Postgres connection. Locally: postgres://postgres:postgres@localhost:5432/kente
# On Supabase: the "Session pooler" connection string (role postgres).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kente

# Public URL of the app, used in invite links and emails.
APP_URL=http://localhost:3000

# Supabase Auth. Leave blank to use built-in local email/password auth
# (development only; refused when NODE_ENV=production).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret used to sign local-auth session cookies (any long random string).
AUTH_SECRET=change-me-to-a-long-random-string

# Resend. Leave blank to log emails to the server console instead.
RESEND_API_KEY=
EMAIL_FROM="Kente <noreply@example.com>"
